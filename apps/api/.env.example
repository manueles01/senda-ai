# Phorest Salon Management
# NOTE: Use api-gateway-us.phorest.com for US accounts, api-gateway-eu.phorest.com for EU
# Authentication: Username/password will be auto-prefixed with "global/" (required by Phorest API)
PHOREST_BASE_URL=https://api-gateway-us.phorest.com
PHOREST_USERNAME=your_phorest_username
PHOREST_PASSWORD=your_phorest_password
PHOREST_BUSINESS_ID=6Sg8C_kl47YIHlStGcv-_Q
PHOREST_BRANCH_ID=mfxegqrFVfJXm_G75LlO8w

# Salon Timezone (for converting UTC times to local)
# Examples: America/New_York, America/Chicago, America/Los_Angeles, America/Denver
SALON_TIMEZONE=America/New_York

# Telnyx Telephony
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_PHONE_NUMBER=+1234567890

# AI Configuration (using Gemini now)
GEMINI_API_KEY=your_gemini_api_key
# OR use GOOGLE_API_KEY if you prefer that env var name

# Anthropic Claude AI (backup, not currently used)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Cloud (optional for future features)
GOOGLE_PROJECT_ID=your_project_id

# Firebase (for user management)
FIREBASE_PROJECT_ID=your_firebase_project_id

# Human Transfer (optional)
TRANSFER_PHONE_NUMBER=+1234567890
